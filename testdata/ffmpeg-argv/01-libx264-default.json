    "-i",
    "pipe:0",
    "-c:v",
    "libx264",
    "-tune",
    "stillimage",
    "-crf",
    "22",
    "-pix_fmt",
    "yuv420p",
    "-fps_mode",
    "vfr",
    "-y",
    "/rec/out.mkv"
  ]
}
